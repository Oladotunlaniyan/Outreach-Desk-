{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/handler.js?__path=$1"
    },
    {
      "source": "/api",
      "destination": "/api/handler.js?__path="
    }
  ]
}
