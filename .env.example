# GEMINI_API_KEY: Required for legacy/other Gemini AI features if used.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# DeepSeek API (Primary AI provider for Phase 3C Email Generation)
DEEPSEEK_API_KEY=""
DEEPSEEK_MODEL="deepseek-chat"
DEEPSEEK_BASE_URL="https://api.deepseek.com"
# DEEPSEEK_TIMEOUT_MS="25000"

# NODE_ENV: Set to "production" in deployed environments ("development" locally).
NODE_ENV="development"

# APP_URL: Public HTTPS origin where Outreach Desk is hosted (required in production for List-Unsubscribe links).
# Example: https://outreach-desk.example.com
APP_URL="http://localhost:3000"

# BOUNCE_WEBHOOK_SECRET: Shared secret for automated ESP bounce webhooks via x-bounce-secret header.
# Generate with: openssl rand -hex 24
BOUNCE_WEBHOOK_SECRET=""

# MONGODB_URI: MongoDB Atlas connection string.
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/outreach_desk?retryWrites=true&w=majority"

# ACCESS_CODE: Personal single-user access code for signing into Outreach Desk (8+ characters recommended).
ACCESS_CODE="change-me-to-a-strong-access-code"

# JWT_SECRET: Long random string (32+ chars) used to sign authentication tokens. Required in production.
# Generate with: openssl rand -hex 32
JWT_SECRET="replace-with-a-long-random-hex-secret"

# MAILBOX_ENCRYPTION_KEY: Base64-encoded 32 random bytes (AES-256-GCM) for encrypting stored SMTP passwords.
# Generate with: openssl rand -base64 32
MAILBOX_ENCRYPTION_KEY="replace-with-32-byte-base64-key"

# SMTP Mailboxes (Optional legacy numbered env vars; never exposed to the client)
# Up to 10 mailboxes supported via SMTP_MAILBOX_1_* .. SMTP_MAILBOX_10_*
# SMTP_MAILBOX_1_ID="primary"
# SMTP_MAILBOX_1_LABEL="Primary Outreach"
# SMTP_MAILBOX_1_HOST="smtp.example.com"
# SMTP_MAILBOX_1_PORT="587"
# SMTP_MAILBOX_1_SECURE="false"
# SMTP_MAILBOX_1_USER="you@example.com"
# SMTP_MAILBOX_1_PASS="your-smtp-app-password"
# SMTP_MAILBOX_1_FROM_NAME="Your Name"
# SMTP_MAILBOX_1_FROM_EMAIL="you@example.com"
# SMTP_MAILBOX_1_DAILY_LIMIT="50"
